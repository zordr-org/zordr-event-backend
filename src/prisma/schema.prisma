  order             Order    @relation(fields: [orderId, eventId], references: [id, eventId], onDelete: Restrict)
  ticketType        TicketType @relation(fields: [ticketTypeId, eventId], references: [id, eventId], onDelete: Restrict)
  tickets           Ticket[]
  registrations     Registration[]

  @@unique([orderId, ticketTypeId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model InventoryHold {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @db.Uuid
  eventId      String            @db.Uuid
  ticketTypeId String            @db.Uuid
  quantity     Int
  status       InventoryHoldStatus @default(ACTIVE)
  expiresAt    DateTime          @db.Timestamptz(6)
  releasedAt   DateTime?         @db.Timestamptz(6)
  consumedAt   DateTime?         @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  order        Order             @relation(fields: [orderId, eventId], references: [id, eventId], onDelete: Restrict)
  ticketType   TicketType        @relation(fields: [ticketTypeId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([orderId, ticketTypeId])
  @@index([eventId])
  @@index([status, expiresAt])
  @@index([ticketTypeId, status, expiresAt])
  @@map("inventory_holds")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @db.Uuid
  provider           PaymentProvider @default(RAZORPAY)
  providerOrderId    String?       @unique
  providerPaymentId  String?       @unique
  amountPaise        BigInt
  currency           String        @default("INR")
  status             PaymentStatus @default(CREATED)
  paymentMethod      String?
  failureCode        String?
  failureMessage     String?
  idempotencyKey     String
  initiatedAt        DateTime      @default(now()) @db.Timestamptz(6)
  authorizedAt       DateTime?     @db.Timestamptz(6)
  capturedAt         DateTime?     @db.Timestamptz(6)
  failedAt           DateTime?     @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds            Refund[]

  @@unique([orderId, idempotencyKey])
  @@unique([id, orderId])
  @@index([orderId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model WebhookEvent {
  id                 String                 @id @default(uuid()) @db.Uuid
  provider           PaymentProvider
  providerEventId    String
  eventType          String
  payload            Json
  signatureVerifiedAt DateTime               @db.Timestamptz(6)
  status             WebhookProcessingStatus @default(RECEIVED)
  attemptCount       Int                    @default(0)
  availableAt        DateTime               @default(now()) @db.Timestamptz(6)
  processingStartedAt DateTime?              @db.Timestamptz(6)
  receivedAt         DateTime               @default(now()) @db.Timestamptz(6)
  processedAt        DateTime?              @db.Timestamptz(6)
  processingError    String?

  @@unique([provider, providerEventId])
  @@index([status, availableAt])
  @@index([processedAt])
  @@map("webhook_events")
}

model Registration {
  id               String   @id @default(uuid()) @db.Uuid
  orderItemId      String   @db.Uuid
  userId           String?
  attendeeName     String
  attendeeEmail    String?
  attendeePhone    String?
  answers          Json     @default("{}")
  formSnapshot     Json
  consentedAt      DateTime? @db.Timestamptz(6)
  consentVersion   String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticket           Ticket?

  @@index([orderItemId])
  @@index([attendeeEmail])
  @@map("registrations")
}

model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  orderItemId     String       @db.Uuid
  registrationId  String?      @unique @db.Uuid
  qrTokenHash     String       @unique
  status          TicketStatus @default(VALID)
  issuedAt        DateTime     @default(now()) @db.Timestamptz(6)
  checkedInAt     DateTime?    @db.Timestamptz(6)
  cancelledAt     DateTime?   @db.Timestamptz(6)
  orderItem       OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  registration    Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  checkIns        CheckIn[]
  scanAttempts    ScanAttempt[]

  @@index([orderItemId, status])
  @@map("tickets")
}

model CheckIn {
  id             String        @id @default(uuid()) @db.Uuid
  ticketId       String        @db.Uuid
  entryNumber    Int           @default(1)
  scannedByActorType ActorType
  scannedByActorId String
  method         CheckInMethod @default(QR)
  clientEventId  String?       @unique
  checkedInAt    DateTime      @default(now()) @db.Timestamptz(6)
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([ticketId, entryNumber])
  @@index([ticketId, checkedInAt])
  @@map("check_ins")
}

model ScanAttempt {
  id             String     @id @default(uuid()) @db.Uuid
  eventId        String     @db.Uuid
  ticketId       String?    @db.Uuid
  scannerActorId String
  result         ScanResult
  scannedAt      DateTime   @default(now()) @db.Timestamptz(6)
  clientEventId  String?    @unique
  details        Json?
  ticket         Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, result, scannedAt])
  @@map("scan_attempts")
}

model FeeConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  platformFeePct     Decimal  @db.Decimal(7, 4)
  perTicketFeePaise  BigInt
  convenienceFeePaise BigInt
  gatewayFeePct      Decimal  @db.Decimal(7, 4)
  gstRatePct         Decimal  @db.Decimal(7, 4)
  feesTaxable        Boolean
  customerPaysFees   Boolean
  effectiveFrom      DateTime @db.Timestamptz(6)
  effectiveUntil     DateTime? @db.Timestamptz(6)
  createdByActorType ActorType?
  createdByActorId   String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  orders             Order[]

  @@unique([name, effectiveFrom])
  @@index([effectiveFrom, effectiveUntil])
  @@map("fee_configs")
}

model Settlement {
  id              String           @id @default(uuid()) @db.Uuid
  organizerId     String           @db.Uuid
  periodStart     DateTime         @db.Timestamptz(6)
  periodEnd       DateTime         @db.Timestamptz(6)
  currency        String           @default("INR")
  grossAmountPaise BigInt
  platformFeesPaise BigInt        @default(0)
  gatewayFeesPaise BigInt         @default(0)
  refundsPaise    BigInt          @default(0)
  adjustmentsPaise BigInt         @default(0)
  netAmountPaise  BigInt
  status          SettlementStatus @default(DRAFT)
  generatedAt     DateTime?        @db.Timestamptz(6)
  approvedAt      DateTime?        @db.Timestamptz(6)
  paidAt          DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  organizer       Organizer        @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  items           SettlementItem[]
  payoutAttempts  SettlementPayoutAttempt[]
  statements      SettlementStatement[]

  @@index([organizerId, status, periodStart])
  @@index([periodStart, periodEnd])
  @@unique([organizerId, periodStart, periodEnd, currency])
  @@map("settlements")
}

model SettlementItem {
  id             String             @id @default(uuid()) @db.Uuid
  settlementId   String             @db.Uuid
  orderId        String             @db.Uuid
  type           SettlementItemType
  sourceKey      String             @unique
  grossAmountPaise BigInt
  feePaise       BigInt             @default(0)
  refundPaise    BigInt             @default(0)
  netAmountPaise BigInt
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  settlement     Settlement         @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, type])
  @@map("settlement_items")
}

model SettlementPayoutAttempt {
  id                 String              @id @default(uuid()) @db.Uuid
  settlementId       String              @db.Uuid
  attemptNumber      Int
  providerPayoutId   String?             @unique
  status             PayoutAttemptStatus @default(CREATED)
  failureCode        String?
  failureMessage     String?
  initiatedAt        DateTime            @default(now()) @db.Timestamptz(6)
  completedAt        DateTime?           @db.Timestamptz(6)
  payoutAccountId    String?             @db.Uuid
  settlement         Settlement          @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payoutAccount      PayoutAccount?      @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)

  @@unique([settlementId, attemptNumber])
  @@index([payoutAccountId])
  @@map("settlement_payout_attempts")
}

model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @db.Uuid
  paymentId          String       @db.Uuid
  amountPaise        BigInt
  currency           String       @default("INR")
  reason             String?
  status             RefundStatus @default(REQUESTED)
  providerRefundId   String?      @unique
  idempotencyKey     String
  requestedByType    ActorType
  requestedById      String
  processedAt        DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment            Payment      @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict)

  @@unique([orderId, idempotencyKey])
  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([status, createdAt])
  @@map("refunds")
}

model AdminEmployee {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  name              String
  passwordHash      String
  department        String?
  status            String        @default("invited")
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?     @db.Timestamptz(6)
  twoFactorEnabled  Boolean       @default(false)
  /// Encrypt with an authenticated encryption scheme before persistence; never store plaintext TOTP secrets.
  twoFactorSecret   String?
  invitedAt         DateTime?     @db.Timestamptz(6)
  lastActiveAt      DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  role              String
  roleDefinition    Role          @relation(fields: [role], references: [name], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  supportTickets    SupportTicket[]
  organizerApprovals Organizer[]  @relation("OrganizerApprovals")
  reviewedOrganizerDocuments OrganizerDocument[] @relation("OrganizerDocumentReviews")
  organizerNotes    OrganizerNote[]
  eventReviews      EventReview[]  @relation("EventReviewers")
  platformSettings  PlatformSetting[]
  invitesSent       AdminInvite[] @relation("AdminInviteIssuer")

  @@index([status, createdAt])
  @@map("admin_employees")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employees   AdminEmployee[]
  permissions RolePermission[]
  invites     AdminInvite[]

  @@map("admin_roles")
}

model AdminInvite {
  id          String        @id @default(uuid()) @db.Uuid
  email       String
  roleId      String        @db.Uuid
  issuedById  String        @db.Uuid
  tokenHash   String        @unique
  expiresAt   DateTime      @db.Timestamptz(6)
  acceptedAt  DateTime?     @db.Timestamptz(6)
  revokedAt   DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  role        Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  issuedBy    AdminEmployee @relation("AdminInviteIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
  @@map("admin_invites")
}

model RolePermission {
