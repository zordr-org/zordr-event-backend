// Proposed shared Zordr platform schema. This is a target design, not a migration.

generator client {
  provider             = "prisma-client"
  output               = "../generated/prisma"
  moduleFormat         = "esm"
  generatedFileExtension = "ts"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  CUSTOMER
  ORGANIZER
  ADMIN_EMPLOYEE
  SYSTEM
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  BLOCKED
  SUSPENDED
  DELETED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
  SUSPENDED
}

enum KycStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum EventStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  SENT_BACK
  REJECTED
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ReviewStatus {
  PENDING
  APPROVED
  SENT_BACK
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

enum RegistrationFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  FILE
}

enum OrderStatus {
  DRAFT
  PENDING
  PAYMENT_PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum RefundStatus {
  REQUESTED
  PENDING
  PROCESSED
  FAILED
  REJECTED
}

enum InventoryHoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  REFUNDED
  VOID
  EXPIRED
}

enum CheckInMethod {
  QR
  MANUAL
  OFFLINE_SYNC
}

enum SettlementStatus {
  DRAFT
  PENDING
  PROCESSING
  PAID
  FAILED
  ON_HOLD
  CANCELLED
}

enum PayoutAttemptStatus {
  CREATED
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum DeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum PayoutAccountStatus {
  PENDING
  VERIFICATION_REQUIRED
  VERIFIED
  REJECTED
  BLOCKED
}

enum ScanResult {
  ACCEPTED
  ALREADY_USED
  INVALID
  CANCELLED
  WRONG_EVENT
  EXPIRED
}

enum SettlementItemType {
  SALE
  REFUND_ADJUSTMENT
  MANUAL_ADJUSTMENT
}

enum WaitlistStatus {
  WAITING
  OFFERED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum AdminModule {
  DASHBOARD
  ORGANIZERS
  EVENTS
  ORDERS
  CUSTOMERS
  SETTLEMENTS
  REFUNDS
  SUPPORT
  ANALYTICS
  EMPLOYEES
  ROLES
  SETTINGS
}

enum AdminAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
}

model User {
  id             String        @id
  name           String?
  domain_email   String?       @unique
  phone          String?       @unique
  status         AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?    @db.Timestamptz(6)
  phoneVerifiedAt DateTime?    @db.Timestamptz(6)
  avatarUrl      String?
  city           String?
  state          String?
  college        String?
  branch         String?
  year           Int?
  rollNumber     String?
  language       String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  organizer           Organizer?              @relation("OrganizerOwner")
  teamMemberships     TeamMember[]
  orders              Order[]
  registrations       Registration[]
  wishlist            Wishlist[]
  loyaltyEntries      LoyaltyLedger[]
  notificationPreferences NotificationPreference[]
  interests           UserInterest[]
  supportRequests     SupportTicket[]          @relation("CustomerSupportRequests")

  @@index([status, createdAt])
  @@map("user")
}

model Organizer {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique
  slug           String?         @unique
  orgName        String?
  orgType        String?
  description    String?
  email          String?
  phone          String?          @unique
  alternatePhone String?
  website        String?
  instagramUrl   String?
  logoUrl        String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  status         OrganizerStatus @default(PENDING)
  kycStatus      KycStatus       @default(PENDING)
  approvedAt     DateTime?       @db.Timestamptz(6)
  approvedById   String?         @db.Uuid
  rejectionReason String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?       @db.Timestamptz(6)

  user          User                @relation("OrganizerOwner", fields: [userId], references: [id], onDelete: Restrict)
  onboarding    OrganizerOnboarding?
  approvedBy    AdminEmployee?      @relation("OrganizerApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  events        Event[]
  teamMembers   TeamMember[]
  teamInvites   OrganizerTeamInvite[]
  documents     OrganizerDocument[]
  payoutAccounts PayoutAccount[]
  roles         OrganizerRole[]
  notes         OrganizerNote[]
  venues        Venue[]
  settlements   Settlement[]
  supportTickets SupportTicket[]

  @@index([status, kycStatus])
  @@map("organizers")
}

model OrganizerOnboarding {
  id                String           @id @default(uuid()) @db.Uuid
  organizerId       String           @unique @db.Uuid
  selectedPayoutAccountId String?    @unique @db.Uuid
  status            OnboardingStatus @default(DRAFT)
  currentStep       Int              @default(1)
  termsAcceptedAt   DateTime?        @db.Timestamptz(6)
  submittedAt       DateTime?        @db.Timestamptz(6)
  reviewedAt        DateTime?        @db.Timestamptz(6)
  rejectionReason   String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  organizer         Organizer        @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  selectedPayoutAccount PayoutAccount? @relation(fields: [selectedPayoutAccountId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@map("organizer_onboardings")
}

model OrganizerDocument {
  id           String         @id @default(uuid()) @db.Uuid
  organizerId  String         @db.Uuid
  documentType String
  objectKey    String
  status       DocumentStatus @default(PENDING)
  reviewNotes  String?
  reviewedById String?        @db.Uuid
  reviewedAt   DateTime?      @db.Timestamptz(6)
  expiresAt    DateTime?      @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  organizer    Organizer      @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  reviewedBy   AdminEmployee? @relation("OrganizerDocumentReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizerId, status])
  @@map("organizer_documents")
}

model PayoutAccount {
  id                     String            @id @default(uuid()) @db.Uuid
  organizerId            String            @db.Uuid
  accountHolderName      String
  bankName               String?
  branchName             String?
  accountNumberEncrypted String?
  accountLast4           String?
  ifscCode               String?
  upiId                  String?
  razorpayFundAccountId  String?           @unique
  status                 PayoutAccountStatus @default(PENDING)
  verifiedAt             DateTime?         @db.Timestamptz(6)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  organizer              Organizer         @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  payoutAttempts         SettlementPayoutAttempt[]
  onboarding             OrganizerOnboarding?

  @@index([organizerId, isActive, createdAt])
  @@map("payout_accounts")
}

model OrganizerNote {
  id          String   @id @default(uuid()) @db.Uuid
  organizerId String   @db.Uuid
  authorId    String   @db.Uuid
  note        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  author      AdminEmployee @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizerId, createdAt])
  @@map("organizer_notes")
}

model TeamMember {
  id          String   @id @default(uuid()) @db.Uuid
  organizerId String   @db.Uuid
  userId      String
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles       TeamMemberRole[]
  eventAccess TeamMemberEventAccess[]

  @@unique([organizerId, userId])
  @@index([userId, isActive])
  @@index([organizerId, isActive])
  @@map("team_members")
}

model OrganizerTeamInvite {
  id          String    @id @default(uuid()) @db.Uuid
  organizerId String    @db.Uuid
  email       String
  tokenHash   String    @unique
  roleId      String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  role        OrganizerRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  eventScope  OrganizerTeamInviteEvent[]

  @@index([organizerId, email])
  @@index([expiresAt, acceptedAt, revokedAt])
  @@map("organizer_team_invites")
}

model OrganizerTeamInviteEvent {
  inviteId String @db.Uuid
  eventId  String @db.Uuid
  invite   OrganizerTeamInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([inviteId, eventId])
  @@map("organizer_team_invite_events")
}

model OrganizerRole {
  id          String   @id @default(uuid()) @db.Uuid
  organizerId String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  members     TeamMemberRole[]
  permissions OrganizerRolePermission[]
  invites     OrganizerTeamInvite[]

  @@unique([organizerId, name])
  @@map("organizer_roles")
}

model OrganizerRolePermission {
  id         String @id @default(uuid()) @db.Uuid
  roleId     String @db.Uuid
  permission String
  role       OrganizerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("organizer_role_permissions")
}

model TeamMemberRole {
  teamMemberId String @db.Uuid
  roleId       String @db.Uuid
  teamMember   TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  role         OrganizerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([teamMemberId, roleId])
  @@map("team_member_roles")
}

model TeamMemberEventAccess {
  id           String   @id @default(uuid()) @db.Uuid
  teamMemberId String   @db.Uuid
  eventId      String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  permissions  TeamMemberEventPermission[]

  @@unique([teamMemberId, eventId])
  @@index([eventId])
  @@map("team_member_event_access")
}

model TeamMemberEventPermission {
  id            String @id @default(uuid()) @db.Uuid
  eventAccessId String @db.Uuid
  permission    String
  eventAccess   TeamMemberEventAccess @relation(fields: [eventAccessId], references: [id], onDelete: Cascade)

  @@unique([eventAccessId, permission])
  @@map("team_member_event_permissions")
}

model Venue {
  id          String   @id @default(uuid()) @db.Uuid
  organizerId String   @db.Uuid
  name        String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  mapUrl      String?
  instructions String?
  meetingLink String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  facilities  Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  events      Event[]   @relation("PrimaryVenue")
  sessions    EventSession[]

  @@index([organizerId, city])
  @@map("venues")
}

model Event {
  id                  String          @id @default(uuid()) @db.Uuid
  organizerId         String          @db.Uuid
  venueId             String?         @db.Uuid
  slug                String          @unique
  name                String
  shortDescription    String?
  description         String?
  mode                EventMode
  visibility          EventVisibility @default(PUBLIC)
  status              EventStatus     @default(DRAFT)
  startAt             DateTime        @db.Timestamptz(6)
  endAt               DateTime        @db.Timestamptz(6)
  timezone            String          @default("Asia/Kolkata")
  registrationOpensAt DateTime?       @db.Timestamptz(6)
  registrationClosesAt DateTime?      @db.Timestamptz(6)
  maxAttendees        Int?
  waitlistEnabled     Boolean         @default(false)
  ageLimit            Int?
  consentText         String?
  showAttendeeList    Boolean         @default(false)
  showTerms           Boolean         @default(true)
  termsAndConditions  String?
  city                String?
  state               String?
  isFeatured          Boolean         @default(false)
  publishedAt         DateTime?       @db.Timestamptz(6)
  submittedAt         DateTime?       @db.Timestamptz(6)
  scheduledPublishAt  DateTime?       @db.Timestamptz(6)
  cancellationReason  String?
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?       @db.Timestamptz(6)

  organizer          Organizer                @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  primaryVenue       Venue?                   @relation("PrimaryVenue", fields: [venueId], references: [id], onDelete: SetNull)
  categories         EventCategory[]
  tags               EventTag[]
  ticketTypes        TicketType[]
  registrationFields RegistrationField[]
  orders             Order[]
  sessions           EventSession[]
  mediaAssets        MediaAsset[]
  reviews            EventReview[]
  wishlists          Wishlist[]
  faqs               EventFaq[]
  waitlistEntries    WaitlistEntry[]
  supportTickets     SupportTicket[]
  scanAttempts       ScanAttempt[]
  teamMemberAccess   TeamMemberEventAccess[]
  teamInvites        OrganizerTeamInviteEvent[]

  @@index([organizerId, status])
  @@index([status, startAt])
  @@index([city, state, startAt])
  @@index([isFeatured, status, startAt])
  @@map("events")
}

model EventSession {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  venueId   String?  @db.Uuid
  name      String
  description String?
  startsAt  DateTime @db.Timestamptz(6)
  endsAt    DateTime @db.Timestamptz(6)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue     Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([eventId, startsAt, sortOrder])
  @@map("event_sessions")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  events      EventCategory[]
  interests   UserInterest[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model EventCategory {
  eventId    String @db.Uuid
  categoryId String @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([eventId, categoryId])
  @@index([categoryId, eventId])
  @@map("event_categories")
}

model UserInterest {
  userId     String
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId, userId])
  @@map("user_interests")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  events    EventTag[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("tags")
}

model EventTag {
  eventId String @db.Uuid
  tagId   String @db.Uuid
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@map("event_tags")
}

model EventFaq {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_faqs")
}

model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  mediaType   MediaType
  objectKey   String?
  externalUrl String?
  altText     String?
  caption     String?
  sortOrder   Int       @default(0)
  isPrimary   Boolean   @default(false)
  processing  String    @default("READY")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("media_assets")
}

model EventReview {
  id           String       @id @default(uuid()) @db.Uuid
  eventId      String       @db.Uuid
  status       ReviewStatus @default(PENDING)
  reviewerId   String?      @db.Uuid
  reviewNotes  String?
  checklist    Json?
  snapshot     Json?
  version      Int          @default(1)
  submittedAt  DateTime     @default(now()) @db.Timestamptz(6)
  reviewedAt   DateTime?    @db.Timestamptz(6)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reviewer     AdminEmployee? @relation("EventReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([eventId, version])
  @@index([eventId, submittedAt])
  @@index([status, submittedAt])
  @@map("event_reviews")
}

model TicketType {
  id             String          @id @default(uuid()) @db.Uuid
  eventId        String          @db.Uuid
  name           String
  description    String?
  perks          Json?
  pricePaise     BigInt
  originalPricePaise BigInt?
  currency       String          @default("INR")
  totalQuantity  Int
  soldQuantity   Int             @default(0)
  reservedQuantity Int           @default(0)
  purchaseLimit  Int?
  minimumPurchase Int            @default(1)
  visible        Boolean         @default(true)
  sortOrder      Int             @default(0)
  salesStartAt   DateTime?       @db.Timestamptz(6)
  salesEndAt     DateTime?       @db.Timestamptz(6)
  status         TicketTypeStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  inventoryHolds InventoryHold[]
  waitlistEntries WaitlistEntry[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId, status, visible, sortOrder])
  @@map("ticket_types")
}

model RegistrationField {
  id           String                @id @default(uuid()) @db.Uuid
  eventId      String                @db.Uuid
  fieldKey     String
  label        String
  description  String?
  fieldType    RegistrationFieldType
  required     Boolean               @default(false)
  options      Json?
  validation   Json?
  section      String?
  sortOrder    Int                   @default(0)
  isSystem     Boolean               @default(false)
  isActive     Boolean               @default(true)
  version      Int                   @default(1)
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(6)
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, fieldKey, version])
  @@index([eventId, isActive, sortOrder])
  @@map("registration_fields")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       String      @unique
  userId            String
  eventId           String      @db.Uuid
  status            OrderStatus @default(PENDING)
  currency          String      @default("INR")
  subtotalPaise     BigInt
  discountPaise     BigInt      @default(0)
  convenienceFeePaise BigInt    @default(0)
  platformFeePaise  BigInt      @default(0)
  gatewayFeePaise   BigInt      @default(0)
  taxPaise          BigInt      @default(0)
  totalPaise        BigInt
  feeConfigId       String      @db.Uuid
  feeSnapshot       Json
  pricingVersion    String
  paymentCapturedAt DateTime?   @db.Timestamptz(6)
  expiresAt         DateTime?   @db.Timestamptz(6)
  idempotencyKey    String
  requestHash       String
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  event             Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  feeConfig         FeeConfig   @relation(fields: [feeConfigId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  inventoryHolds    InventoryHold[]
  refunds           Refund[]
  settlementItems   SettlementItem[]
  waitlistEntry     WaitlistEntry?
  invoice           Invoice?
  supportTickets    SupportTicket[]
  loyaltyEntries    LoyaltyLedger[]

  @@unique([userId, idempotencyKey])
  @@unique([id, eventId])
  @@index([userId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
