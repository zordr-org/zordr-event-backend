}

model RefreshToken {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @db.Uuid
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(6)
  revokedAt DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  admin     AdminEmployee @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, expiresAt])
  @@map("refresh_tokens")
}

model SupportTicket {
  id              String         @id @default(uuid()) @db.Uuid
  requesterType   ActorType
  customerId      String?
  organizerId     String?        @db.Uuid
  assignedToId    String?        @db.Uuid
  eventId         String?        @db.Uuid
  orderId         String?        @db.Uuid
  subject         String
  description     String
  category        String?
  priority        SupportPriority @default(MEDIUM)
  status          SupportStatus  @default(OPEN)
  firstResponseAt DateTime?      @db.Timestamptz(6)
  slaDueAt        DateTime?      @db.Timestamptz(6)
  resolvedAt      DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  customer        User?          @relation("CustomerSupportRequests", fields: [customerId], references: [id], onDelete: SetNull)
  organizer       Organizer?     @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  assignedAdmin   AdminEmployee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
