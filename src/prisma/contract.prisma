// use prisma-next

model Organizer {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  orgName     String
  orgType     String
  logoUrl     String?
  kycStatus   KycStatus @default(PENDING)
  phone       String    @unique
  email       String?
  city        String?
  createdAt   TimestamptzString @default(now())

  events      Event[]
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id            String     @id @default(uuid())
  name          String
  domain_email  String
  phone         String
  password_hash String
  sso_providers String[]
  college       String
  branch        String
  year          Int

  organizer     Organizer?
}



model Event {
  id          Int         @id @default(autoincrement())
  organizer   Organizer   @relation(fields: [organizerId], references: [id])
  organizerId String
  name        String
  category    String
  mode        String
  status      EventStatus @default(DRAFT)
  startAt     TimestamptzString
  endAt       TimestamptzString
  publishedAt TimestamptzString?
  createdAt   TimestamptzString @default(now())
}

enum EventStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  PUBLISHED
  SENT_BACK
  REJECTED
  ONGOING
  COMPLETED
  CANCELLED
}